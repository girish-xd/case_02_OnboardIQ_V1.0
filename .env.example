# OnboardIQ — Environment Configuration Template
# Copy this file to backend/.env and frontend/.env respectively

# ==========================================
# BACKEND ENVIRONMENT VARIABLES (backend/.env)
# ==========================================

# Server Port
PORT=5000

# Environment Mode (development | production | test)
NODE_ENV=development

# Database Configuration
# Optional: If omitted, the backend automatically boots an in-memory MongoDB instance (zero-config local dev & tests)
# For production, supply your MongoDB Atlas connection string:
# MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/onboardiq?retryWrites=true&w=majority

# JWT Session Authentication Secret (Use a strong 64+ char random hex string in production)
JWT_SECRET=onboardiq-development-super-secret-key-change-in-production-2026

# Cookie Signing Secret
COOKIE_SECRET=onboardiq-cookie-signing-secret-2026

# CORS Origin Allowlist (Comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000

# Optional: Groq API Key for Generative AI Reviewer Summaries
# If omitted or invalid, the platform gracefully uses deterministic reviewer summaries
# GROQ_API_KEY=gsk_...

# Optional: Cloudinary Storage Configuration
# If omitted, documents are stored securely in the local authenticated filesystem (backend/uploads)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>


# ===========================================
# FRONTEND ENVIRONMENT VARIABLES (frontend/.env)
# ===========================================

# API Base URL (Default for local dev Vite proxy is empty or /api)
# In production, set to your deployed backend URL:
# VITE_API_URL=https://onboardiq-backend.up.railway.app
